NAME="Великая Земля"
YEAR="2053"
NAMEPROJECT="New Government"
BGCOLOR="#000000"
WIDTH="1200"
HEIGHT="650"

BASEOFFBUTTONCOLOR="#bbff88" # зеленые тона
BASEONBUTTONCOLOR="#bbff88"
BASEOFFBGBUTTONCOLOR="#011001"
BASEONBGBUTTONCOLOR="#203010"

CANCELOFFBUTTONCOLOR="#ff8080" # алые тона
CANCELONBUTTONCOLOR="#ff9090"
CANCELOFFBGBUTTONCOLOR="#200101"
CANCELONBGBUTTONCOLOR="#501010"

MAINBUTTONCOORDINATES="150 500 1050 600"
MAINBUTTONTEXT="Играть"

PATHTOPICTUREINTOMAINMENU="data/res/PICTUREINTOMAINMENU.png"
# оно должно быть соотношением 1150px на 250px, фон должен быть черным (или темно-зеленым),
# а текст зеленым в примерно этих тонах: #5b803b, #bbff88, #2b500b,
COORDINATESPICTUREINTOMAINMENU="75 -25"

CHARACTERBUTTONTEXT="Далее"
CHARACTERMENUTEXTINFO="Выберите политика, за которого собираетесь играть"
CHARACTERBUTTONCOORDINATES="20 570 940 630"

CANCELCHARACTERBUTTONCOORDINATES="960 570 1180 630"
CANCELCHARACTERBUTTONTEXT="Назад"

COLORSNOICE="#001800 #051803 #021801 #011801"
SIZENOICE="1"
QUANTITYNOICE="200"

PATHTOCHOOSECHARACTERPICTURE="data/res/CHOOSECHARACTERPICTURE.png"
# оно должно быть в горизантальном соотношении 1200px на 600px, фон черный, цветовая гамма та же
# на фото должно быть сверху изображен прямоугольная рамка портрета в том же стиле, но в портрете
# ничего не должно быть изображено - лишь черный фон, это рамка для президента
# ниже 6 почти таких же рамок министров (размеры у всех рамок должны быть одинаковые)
# никаких надписей на фото
COORDINATESCHOOSECHARACTERPICTURE="600 300"